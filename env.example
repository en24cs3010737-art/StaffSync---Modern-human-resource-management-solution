NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/staffsync_dev

# Generate a unique secret for local development; never commit real secrets.
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_ACCESS_TTL=10m
JWT_REFRESH_SECRET=replace_with_a_different_32_character_secret
JWT_REFRESH_TTL=7d

# Cookie policy. Production deployments must use HTTPS and Secure cookies.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# Business timezone used for work-date calculations (configure policy before production).
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=info
